generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id                  String                @id @default(cuid())
  name                String
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  tests               Test[]
  environments        Environment[]
  channels            NotificationChannel[]
  suites              Suite[]
  suiteRuns           SuiteRun[]
  schedules           Schedule[]
  members             ProjectMember[]
  authStates          ProjectAuthState[]
  databaseConnections DatabaseConnection[]
  variables           ProjectVariable[]
}

model User {
  id           String          @id @default(cuid())
  email        String          @unique
  passwordHash String
  createdAt    DateTime        @default(now())
  memberships  ProjectMember[]
  apiTokens    ApiToken[]
}

model ApiToken {
  id          String    @id @default(cuid())
  userId      String
  name        String
  tokenHash   String    @unique
  tokenPrefix String
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model InstanceSettings {
  id           Int      @id @default(1)
  activeLocale String   @default("en")
  updatedAt    DateTime @updatedAt
}

model LanguagePack {
  locale       String   @id
  displayName  String
  translations Json     @default("{}")
  sourceHashes Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Test {
  id                       String             @id @default(cuid())
  name                     String
  url                      String
  device                   String?
  steps                    Json               @default("[]")
  testData                 Json               @default("[]")
  environmentId            String?
  useProjectAuthentication Boolean            @default(true)
  projectId                String
  project                  Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment              Environment?       @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt
  runs                     TestRun[]
  runBatches               TestRunBatch[]
  schedules                Schedule[]
  authProfiles             ProjectAuthState[] @relation("AuthCheck")
}

model TestRun {
  id                     String            @id @default(cuid())
  status                 RunStatus         @default(PENDING)
  runMode                RunMode           @default(NORMAL)
  startedAt              DateTime          @default(now())
  finishedAt             DateTime?
  durationMs             Int?
  error                  String?
  tracePath              String?
  traceUnavailableReason String?
  screenshots            Json              @default("[]")
  stepResults            Json              @default("[]")
  dataCaseName           String?
  dataCaseIndex          Int?
  dataCaseVariables      Json?
  variablesSnapshot      String?
  runInputsSnapshot      String?
  authStateId            String?
  batchId                String?
  batch                  TestRunBatch?     @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchOrder             Int?
  suiteRunId             String?
  suiteOrder             Int?
  currentStep            Int?
  totalSteps             Int?
  environmentId          String?
  scheduleId             String?
  testId                 String
  test                   Test              @relation(fields: [testId], references: [id], onDelete: Cascade)
  environment            Environment?      @relation(fields: [environmentId], references: [id])
  schedule               Schedule?         @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  authState              ProjectAuthState? @relation("AuthRefreshRuns", fields: [authStateId], references: [id], onDelete: SetNull)
  refreshedAuthState     ProjectAuthState? @relation("RefreshedAuthRun")
  suiteRun               SuiteRun?         @relation(fields: [suiteRunId], references: [id], onDelete: SetNull)

  @@unique([suiteRunId, suiteOrder])
  @@index([authStateId])
  @@index([suiteRunId, suiteOrder])
}

model TestRunBatch {
  id             String      @id @default(cuid())
  testId         String
  environmentId  String?
  status         BatchStatus @default(PENDING)
  totalCases     Int
  completedCases Int         @default(0)
  passedCases    Int         @default(0)
  failedCases    Int         @default(0)
  startedAt      DateTime    @default(now())
  finishedAt     DateTime?
  createdAt      DateTime    @default(now())

  test Test      @relation(fields: [testId], references: [id], onDelete: Cascade)
  runs TestRun[]

  @@index([testId])
  @@index([status])
}

model Suite {
  id              String             @id @default(cuid())
  name            String
  projectId       String
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testIds         Json               @default("[]")
  executionMode   SuiteExecutionMode @default(INDEPENDENT)
  executionConfig Json               @default("{}")
  schedules       Schedule[]
  runs            SuiteRun[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
}

model SuiteRun {
  id               String             @id @default(cuid())
  suiteId          String?
  projectId        String
  suiteName        String
  environmentId    String?
  scheduleId       String?
  triggeredBy      String?
  executionMode    SuiteExecutionMode
  status           SuiteRunStatus     @default(PENDING)
  configSnapshot   Json
  outputSnapshot   String?
  outputMetadata   Json               @default("[]")
  currentOrder     Int                @default(-1)
  error            String?
  startedAt        DateTime?
  finishedAt       DateTime?
  handoffExpiresAt DateTime?
  createdAt        DateTime           @default(now())
  suite            Suite?             @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  project          Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  schedule         Schedule?          @relation(fields: [scheduleId], references: [id], onDelete: SetNull)
  testRuns         TestRun[]

  @@index([projectId, createdAt])
  @@index([status, currentOrder])
  @@index([handoffExpiresAt])
}

model Schedule {
  id            String       @id @default(cuid())
  name          String
  cron          String
  projectId     String
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  suiteId       String?
  suite         Suite?       @relation(fields: [suiteId], references: [id], onDelete: SetNull)
  testId        String?
  test          Test?        @relation(fields: [testId], references: [id], onDelete: SetNull)
  environmentId String?
  environment   Environment? @relation(fields: [environmentId], references: [id], onDelete: SetNull)
  enabled       Boolean      @default(true)
  lastRunAt     DateTime?
  createdAt     DateTime     @default(now())
  runs          TestRun[]
  suiteRuns     SuiteRun[]
}

model Environment {
  id         String             @id @default(cuid())
  name       String
  projectId  String
  project    Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  variables  Json               @default("{}")
  tests      Test[]
  runs       TestRun[]
  schedules  Schedule[]
  authStates ProjectAuthState[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
}

model ProjectVariable {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  type        String
  value       String
  secret      Boolean  @default(false)
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([projectId, name])
  @@index([projectId])
}

model DatabaseConnection {
  id                    String               @id @default(cuid())
  projectId             String
  project               Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name                  String
  provider              DatabaseProvider
  host                  String
  port                  Int
  database              String
  username              String
  encryptedCredentials  String
  ssl                   Boolean              @default(true)
  accessMode            DatabaseAccessMode   @default(READ_ONLY)
  lastCheckedAt         DateTime?
  lastSuccessfulCheckAt DateTime?
  lastCheckStatus       DatabaseCheckStatus?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  @@index([projectId])
}

model ProjectAuthState {
  id             String          @id @default(cuid())
  projectId      String
  environmentId  String
  authCheckId    String
  enabled        Boolean         @default(false)
  status         AuthStateStatus @default(UNAVAILABLE)
  storageKey     String?
  refreshedAt    DateTime?
  refreshedRunId String?         @unique
  lastError      String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  project      Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  environment  Environment @relation(fields: [environmentId], references: [id], onDelete: Cascade)
  authCheck    Test        @relation("AuthCheck", fields: [authCheckId], references: [id], onDelete: Restrict)
  refreshedRun TestRun?    @relation("RefreshedAuthRun", fields: [refreshedRunId], references: [id], onDelete: SetNull)
  refreshRuns  TestRun[]   @relation("AuthRefreshRuns")

  @@unique([projectId, environmentId])
  @@index([authCheckId])
}

model NotificationChannel {
  id             String    @id @default(cuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           String
  name           String
  config         Json
  onFailed       Boolean   @default(true)
  onRecovered    Boolean   @default(true)
  onPassed       Boolean   @default(false)
  enabled        Boolean   @default(true)
  lastTestAt     DateTime?
  lastTestStatus String?
  createdAt      DateTime  @default(now())
}

model ProjectMember {
  id        String              @id @default(cuid())
  projectId String
  userId    String?
  email     String
  role      ProjectRole
  status    ProjectMemberStatus @default(ACTIVE)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, email])
  @@index([projectId])
  @@index([userId])
}

enum RunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
}

enum SuiteExecutionMode {
  INDEPENDENT
  SEQUENTIAL
}

enum SuiteRunStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
  CANCELLED
}

enum RunMode {
  NORMAL
  AUTH_REFRESH
}

enum AuthStateStatus {
  UNAVAILABLE
  REFRESHING
  AVAILABLE
  REFRESH_FAILED
}

enum BatchStatus {
  PENDING
  RUNNING
  PASSED
  FAILED
}

enum ProjectRole {
  OWNER
  EDITOR
  VIEWER
}

enum ProjectMemberStatus {
  ACTIVE
  PENDING
}

enum DatabaseProvider {
  POSTGRESQL
  MYSQL
  SUPABASE
}

enum DatabaseAccessMode {
  READ_ONLY
  READ_WRITE
}

enum DatabaseCheckStatus {
  CONNECTED
  FAILED
}
